# Copy to .env.local and fill in. Never commit .env.local.

# Replicate API token for AI photo generation, under the scoped ADR 0008
# exception. Create one at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Module-level kill switch for photo generation (ADR 0008, gap G11). Generation
# is OFF unless this is exactly "true"; requesting, listing, status and
# cancellation keep working either way, and jobs fail as "provider-disabled".
# Turning it on spends Replicate credits — a deliberate decision, not a default.
PHOTO_GENERATION_ENABLED=false

# Signing secret of the account's default webhook, from
# GET https://api.replicate.com/v1/webhooks/default/secret (starts with whsec_).
# Without it every delivery to /api/webhooks/replicate is refused.
REPLICATE_WEBHOOK_SIGNING_SECRET=

# Public HTTPS URL the provider delivers events to, e.g.
# https://<host>/api/webhooks/replicate. Leave empty locally: the application
# is not reachable from outside, and jobs then complete by reconciliation.
PHOTO_WEBHOOK_URL=

# Bearer for POST /api/photo-jobs/sweep (header x-sweep-token), the scheduled
# reconciliation of in-flight jobs. Unset means the route does not exist.
PHOTO_SWEEP_TOKEN=

# Ceilings of ADR 0008 gap G7, each a rolling 24 h window. The customer quota
# is counted per account at request; the two budgets are counted across all
# accounts at submission (jobs, and cents from the Model Release's estimate).
# Defaults apply when unset: 25 / 200 / 2000.
PHOTO_CUSTOMER_DAILY_JOBS=
PHOTO_DAILY_BUDGET_JOBS=
PHOTO_DAILY_BUDGET_CENTS=

# Pooled runtime connections. Keep these server-only.
DATABASE_URL=
DATABASE_URL_AUTH=

# Direct connection used only by dbmate, schema generation, and operations.
DATABASE_URL_DIRECT=

# Better Auth runtime configuration. Generate a random secret of at least 32 characters.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Transactional authentication email. `development-capture` keeps every
# authentication mail in the database (app.development_email_capture) instead
# of sending it and shows the one-time code on the login screen. Production
# provider selection is intentionally deferred and fails closed when unset.
TRANSACTIONAL_EMAIL_PROVIDER=

# A production build (`pnpm build`, Vercel) refuses `development-capture`
# unless this is exactly "true". Set it ONLY on test deployments that have no
# mail provider yet; it makes login codes visible to whoever opens the page.
# Never set it on the customer-facing production project (ADR 0010).
ALLOW_DEVELOPMENT_EMAIL_CAPTURE_IN_PRODUCTION=

# Optional disposable PostgreSQL/Neon database for `pnpm test:db`.
# Without this, the suite starts a Testcontainers PostgreSQL instance.
TEST_DATABASE_URL=

# Self-hosted S3-compatible object storage for Source Captures and Generated
# Photos (ADR 0011). The bucket is private; nothing is ever served from a public
# URL. Console: https://ecomstorage.rotpunkt.ai/rustfs/console/
#
# OBJECT_STORAGE_REGION is a SigV4 signing-scope literal, not a location. It only
# has to match the server's RUSTFS_REGION. Changing it here alone breaks signing.
OBJECT_STORAGE_ENDPOINT=https://ecomstorage.rotpunkt.ai
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Sanity editorial content (ADR 0007, .scratch/sanity-pagebuilder/spec.md).
# Without a project id the site runs in demo mode from its local content and
# /studio shows a setup notice. The development dataset holds synthetic content
# only; production waits for the DPA and transfer review.
NEXT_PUBLIC_SANITY_PROJECT_ID=06g3ozu4
NEXT_PUBLIC_SANITY_DATASET=development
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01

# Viewer token. Required: the datasets are private, so published pages need it
# as well as draft preview. It reaches the browser in draft mode, so it must
# never carry write access.
SANITY_API_READ_TOKEN=

# Optional: a project token for Sanity CLI work (schema deploy, `pnpm sanity:seed`)
# without switching the machine's `sanity login`. Pass it as SANITY_AUTH_TOKEN to
# the CLI; the application never reads this variable.
SANITY_CLI_TOKEN=

# Secret of the Sanity publish webhook that delivers to POST /api/webhooks/sanity
# (Sanity: API → Webhooks, filter on the published document types, HTTP POST,
# "Secret" set to the same value). A verified delivery expires the "sanity" cache
# tag so published edits appear without a rebuild. Unset means the route does
# not exist; unsigned or forged deliveries are refused.
SANITY_REVALIDATE_SECRET=

# Public origin for canonical URLs, hreflang, sitemap.xml and robots.txt, e.g.
# https://www.example.com (no trailing slash). Unset on Vercel: the project's
# production domain (VERCEL_PROJECT_PRODUCTION_URL); unset locally: localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Test deployments only: "true" opens English and Spanish before they launch, so
# translations and the language switch can be reviewed on a deployment. Vercel's
# Production counts as a test environment for now (STATUS.md, Deployment); remove
# the flag there before real customers arrive. `pnpm dev` opens every locale anyway.
OPEN_ALL_LOCALES=

# The launched site only: "true" lets search engines index it. Unset everywhere
# else, so every response says noindex. Previews never index, and neither does a
# deployment that still sets OPEN_ALL_LOCALES or the email-capture flag.
SEARCH_INDEXING_ENABLED=

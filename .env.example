# Copy to .env.local and fill in. Never commit .env.local.

# Replicate API token for the AI photo feature (/api/photo).
# Create one at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Pooled runtime connections. Keep these server-only.
DATABASE_URL=
DATABASE_URL_AUTH=

# Direct connection used only by dbmate, schema generation, and operations.
DATABASE_URL_DIRECT=

# Better Auth runtime configuration. Generate a random secret of at least 32 characters.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Transactional authentication email. Use `development-capture` locally only.
# Production provider selection is intentionally deferred and fails closed.
TRANSACTIONAL_EMAIL_PROVIDER=

# Optional disposable PostgreSQL/Neon database for `pnpm test:db`.
# Without this, the suite starts a Testcontainers PostgreSQL instance.
TEST_DATABASE_URL

# Self-hosted S3-compatible object storage for Source Captures and Generated
# Photos (ADR 0011). The bucket is private; nothing is ever served from a public
# URL. Console: https://ecomstorage.rotpunkt.ai/rustfs/console/
#
# OBJECT_STORAGE_REGION is a SigV4 signing-scope literal, not a location. It only
# has to match the server's RUSTFS_REGION. Changing it here alone breaks signing.
OBJECT_STORAGE_ENDPOINT=https://ecomstorage.rotpunkt.ai
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_BUCKET
OBJECT_STORAGE_ACCESS_KEY_ID
OBJECT_STORAGE_SECRET_ACCESS_KEY=

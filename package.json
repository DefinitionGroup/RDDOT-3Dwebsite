{
  "name": "rdtdot-ecom",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.7.0",
  "scripts": {
    "dev": "next dev",
    "typegen": "sanity schema extract --enforce-required-fields --force && sanity typegen generate",
    "sanity:seed": "sanity exec scripts/seed-sanity.ts --with-user-token --",
    "prebuild": "pnpm typegen",
    "build": "next build",
    "postbuild": "node scripts/verify-server-bundle.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run features lib",
    "test:db": "vitest run tests/integration",
    "db:migrate": "node scripts/dbmate.mjs up",
    "db:rollback": "node scripts/dbmate.mjs rollback",
    "db:schema": "node scripts/dbmate.mjs dump",
    "assets:manifest": "node scripts/build-asset-manifest.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@aws-sdk/s3-request-presigner": "^3.1123.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.8.2",
    "@react-three/gpu-pathtracer": "^0.3.2",
    "@react-three/postprocessing": "^3.0.4",
    "@sanity/client": "^7.26.2",
    "@sanity/document-internationalization": "^6.2.39",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.20.0",
    "@types/three": "^0.184.1",
    "@vercel/functions": "3.10.1",
    "better-auth": "1.6.27",
    "kysely": "0.29.5",
    "lucide-react": "^1.21.0",
    "lz-string": "^1.5.0",
    "motion": "^12.43.0",
    "n8ao": "^1.10.2",
    "next": "16.4.1",
    "next-sanity": "^13.3.4",
    "pg": "8.23.0",
    "postprocessing": "^6.39.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "replicate": "^1.4.0",
    "sanity": "^6.20.0",
    "sanity-plugin-internationalized-array": "^5.3.2",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "styled-components": "^6.5.3",
    "three": "^0.184.0",
    "three-gpu-pathtracer": "0.0.23",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "^26.1.0",
    "@types/pg": "8.21.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "auth": "1.6.27",
    "autoprefixer": "^10.4.21",
    "dbmate": "2.35.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "overrides": {
      "js-yaml@>=3.0.0 <3.15.2": "^3.15.2",
      "smol-toml@<1.9.0": "^1.9.1",
      "lodash@>=4.0.0 <4.18.0": "^4.18.1",
      "dompurify@>=3.0.0 <3.4.17": "^3.4.17",
      "uuid@>=10.0.0 <11.1.1": "^11.1.1"
    }
